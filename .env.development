# Vite dev server proxies /store, /cms, /health to the local backend (see vite.config.ts),
# so the API base is relative/same-origin in dev.
VITE_API_BASE_URL=

# Hostname that should render the CMS shell. Irrelevant in dev — visit /cms or /store instead
# (or ?shell=cms|store — see src/app/shell-resolver.ts) since localhost can't fake real domains.
VITE_CMS_APP_DOMAIN=cms.localhost

# Sent as the X-Tenant-Host header on every Store API request in dev, since the backend
# resolves tenants by Host header and localhost has none. Point this at a tenant domain
# that exists in your local database.
VITE_DEV_TENANT_HOST=tokosaya.com

# Which shell to render on localhost when no /cms, /store, or ?shell= override is present or stored.
VITE_DEV_DEFAULT_SHELL=store
