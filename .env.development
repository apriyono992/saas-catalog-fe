# Vite dev server proxies /store, /cms, /health to the local backend (see vite.config.ts),
# so the API base is relative/same-origin in dev.
VITE_API_BASE_URL=http://localhost:3000

# Simulates the Origin header in dev so the backend can resolve the tenant.
# Set to a domain that exists in your local domains table.
VITE_DEV_TENANT_HOST=tokosaya.com
